# ====== Banco de dados (Supabase -> Project Settings -> Database -> Connection string "URI") ======
DATABASE_URL=postgresql://postgres:SUASENHA@db.xxxxxxxx.supabase.co:5432/postgres

# ====== Segredo usado para assinar/gerar as chaves de licenca (gere um valor aleatorio grande e guarde em segredo) ======
LICENSE_SECRET=troque_isto_por_uma_string_aleatoria_bem_grande_e_unica

# ====== Segredo que a Greenn deve enviar para validarmos que o webhook e legitimo ======
# (Configure a mesma string la no painel da Greenn, no campo de "secret"/token do Webhook, se o produto tiver essa opcao;
#  caso a Greenn nao ofereca assinatura de webhook, deixe esta mesma chave em GREENN_WEBHOOK_TOKEN e
#  configure a URL do webhook como https://seuservidor.com/webhook/greenn?token=SEU_TOKEN)
GREENN_WEBHOOK_TOKEN=troque_isto_tambem

# ====== Brevo (ex-Sendinblue) - conta gratis em https://www.brevo.com -> SMTP & API -> API Keys ======
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=licencas@seudominio.com
EMAIL_FROM_NAME=Nome do seu indicador

# ====== Mapeamento: ID do produto na Greenn -> dias de validade do plano ======
# Pegue o product.id de cada um dos seus 3 produtos (Mensal/Trimestral/Anual) no painel da Greenn
# ou olhando o primeiro webhook de teste que chegar (ele vem no payload em product.id).
# Formato: {"ID_PRODUTO_MENSAL":30,"ID_PRODUTO_TRIMESTRAL":90,"ID_PRODUTO_ANUAL":365}
PLAN_DAYS_BY_PRODUCT_ID={"111":30,"222":90,"333":365}

PORT=3000
